# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/attached_assets/generated_images/
/.canvas/assets/merch-refresh-*
/generated-artifacts/
.pythonlibs/
__pycache__/
/artifacts/sless-studio/.next/
/artifacts/sless-studio/.next-build/
/artifacts/sless-studio/.data/
/artifacts/sless-studio/.env.local
/artifacts/sless-studio/playwright-report/
/artifacts/sless-studio/test-results/
